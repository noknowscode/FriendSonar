<Page x:Class="FriendSonar.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:FriendSonar.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      mc:Ignorable="d"
      Background="{ThemeResource TerminalBlackBrush}">

  <Grid MaxWidth="420" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0"
          Padding="20,16"
          BorderThickness="0,0,0,1"
          BorderBrush="{ThemeResource PhosphorGreen20Brush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: Title with status dot -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <Ellipse Width="8" Height="8"
                 Fill="{ThemeResource PhosphorGreen100Brush}"
                 VerticalAlignment="Center" />
        <StackPanel Spacing="2">
          <TextBlock Text="SONAR"
                     Style="{StaticResource SonarTitleTextBlockStyle}" />
          <TextBlock Text="FRIEND DETECTION SYSTEM v3.0"
                     Style="{StaticResource SonarSubtitleTextBlockStyle}"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Opacity="0.53" />
        </StackPanel>
      </StackPanel>

      <!-- Right: Contact Count and Last Scan -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
          <TextBlock Text="CONTACTS"
                     Style="{StaticResource SonarCountLabelTextBlockStyle}"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="ContactCount"
                     Text="5"
                     Style="{StaticResource SonarCountTextBlockStyle}"
                     Foreground="{ThemeResource PhosphorGreen100Brush}" />
        </StackPanel>
        <TextBlock x:Name="LastScanText"
                   Text="LAST SCAN: 51s"
                   Style="{StaticResource SonarCountLabelTextBlockStyle}"
                   Opacity="0.53"
                   HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>

    <!-- Range Toggle Buttons (moved to top) -->
    <Border Grid.Row="1"
            Padding="20,12"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource PhosphorGreen12Brush}">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="8">
        <ToggleButton x:Name="Range1Button"
                      Content="1 MI"
                      Click="RangeButton_Click"
                      Tag="1"
                      Style="{StaticResource SonarRangeToggleButtonStyle}" />
        <ToggleButton x:Name="Range3Button"
                      Content="3 MI"
                      Click="RangeButton_Click"
                      Tag="3"
                      IsChecked="True"
                      Style="{StaticResource SonarRangeToggleButtonStyle}" />
        <ToggleButton x:Name="Range5Button"
                      Content="5 MI"
                      Click="RangeButton_Click"
                      Tag="5"
                      Style="{StaticResource SonarRangeToggleButtonStyle}" />
        <ToggleButton x:Name="Range10Button"
                      Content="10 MI"
                      Click="RangeButton_Click"
                      Tag="10"
                      Style="{StaticResource SonarRangeToggleButtonStyle}" />
      </StackPanel>
    </Border>

    <!-- Radar Display -->
    <controls:RadarDisplay x:Name="RadarDisplay"
                           Grid.Row="2"
                           Margin="0,12,0,0" />

    <!-- Status Bar -->
    <Grid Grid.Row="3"
          Padding="20,12"
          BorderThickness="0,1,0,0"
          BorderBrush="{ThemeResource PhosphorGreen12Brush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="FREQ: 38.2 kHz"
                 Style="{StaticResource SonarStatusBarTextBlockStyle}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left" />

      <TextBlock x:Name="RangeText"
                 Grid.Column="1"
                 Text="RANGE: 3 MI"
                 Style="{StaticResource SonarStatusBarTextBlockStyle}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />

      <TextBlock x:Name="PingAngle"
                 Grid.Column="2"
                 Text="PING: 206°"
                 Style="{StaticResource SonarStatusBarTextBlockStyle}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right" />
    </Grid>

    <!-- Contact List with Pull-to-Refresh -->
    <RefreshContainer x:Name="RefreshContainer"
                      Grid.Row="4"
                      RefreshRequested="RefreshContainer_RefreshRequested">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <controls:ContactList x:Name="ContactListControl" />
      </ScrollViewer>
    </RefreshContainer>

    <!-- Bottom Controls -->
    <Grid Grid.Row="5"
          Padding="20,16"
          Background="{ThemeResource TerminalBlackBrush}">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="12">
        <Button Style="{StaticResource SonarIconButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{ThemeResource PhosphorGreen100Brush}" VerticalAlignment="Center" />
            <TextBlock Text="PING ALL" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SonarIconButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE71C;" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="FILTER" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SonarIconButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE713;" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="SETTINGS" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- CRT Overlay (Full Screen) -->
    <controls:CRTOverlay Grid.RowSpan="6" />

    <!-- Friend Detail Panel (slide-up overlay) -->
    <controls:FriendDetailPanel x:Name="FriendDetailPanel"
                                 Grid.RowSpan="6" />
  </Grid>
</Page>
